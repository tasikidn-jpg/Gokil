# Gokil Agent — environment configuration
# Copy this file to `.env` and fill in your values.

# === LLM Provider (OpenAI-compatible) ===
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1   (any key, e.g. "ollama")
#   LM Studio:  http://localhost:1234/v1
GOKIL_BASE_URL=https://api.openai.com/v1
GOKIL_API_KEY=sk-replace-me
GOKIL_MODEL=gpt-4o-mini

# Sampling
GOKIL_TEMPERATURE=0.7
GOKIL_MAX_TOKENS=2048

# Agent loop
GOKIL_MAX_STEPS=12

# Persona language: id | en | mix
GOKIL_LANG=mix
